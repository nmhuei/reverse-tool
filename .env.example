# Configuration for reverse-tool (.env)
# Only targets configured here will be routed to the LAN interface.
# All other traffic goes via WAN (WLAN). Non-whitelisted LAN traffic is strictly DROPPED by iptables.

# 1. Target Server (supports host:port, URLs, IPs, CIDRs)
# Examples:
#   TARGET_SERVER=10.0.0.10:999
#   TARGET_IPS="http://10.0.0.20:8080/api, 192.168.100.5:22"
#   TARGET_SUBNETS=10.0.0.0/24
TARGET_SERVER=10.0.0.10:999

# 2. Network interfaces
# TARGET_INTERFACE: LAN interface connecting to the target server / lab
# WAN_INTERFACE: Normal Internet Wi-Fi/Ethernet interface (Facebook, Google, etc.)
TARGET_INTERFACE=wlan1
WAN_INTERFACE=wlan0

# 3. Fallback policy if LAN is down ("wan" allows fallback to WLAN, "drop" blocks)
FALLBACK=wan
