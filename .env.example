# reverse-tool Manual Target & Interface Configuration
# Any IP or subnet defined here will be strictly routed via TARGET_INTERFACE

# Target server IP addresses (comma-separated)
TARGET_IPS=10.0.0.100, 10.0.0.101

# Target subnets / CIDRs (comma-separated)
TARGET_SUBNETS=10.0.0.0/24

# Interface to route targets through (e.g. wlan1, eth1, usb0)
TARGET_INTERFACE=wlan1

# Optional: Explicit WAN / Internet interface (auto-detected if omitted)
# WAN_INTERFACE=wlan0

# Action when target interface fails: 'drop' (recommended for security) or 'wan'
FALLBACK=drop
