# Configuration for reverse-tool (.env)
# Only targets configured here will be routed to the LAN interface.
# All other traffic goes via WAN (WLAN). Non-whitelisted LAN traffic is strictly DROPPED by iptables.

# 1. Explicit LAN IP/CIDR allowlist. Every port/protocol to these
# destinations uses LAN; omit ports because they are not a restriction.
LAN_IPS=10.0.0.10,10.0.0.0/24

# 2. LAN domains/URLs. These names alone may use the LAN DNS resolver. The
# returned A/AAAA address is then routed through LAN; all other domains use WLAN.
LAN_DOMAINS=server.lab,https://api.challenge.local/v1
LAN_DNS_SERVER=10.0.0.53

# 3. Network interfaces
# LAN_INTERFACE: LAN interface connecting to the target server / lab
# WAN_INTERFACE: Normal Internet Wi-Fi/Ethernet interface (Facebook, Google, etc.)
LAN_INTERFACE=eth0
WAN_INTERFACE=wlan0

# 4. Configured LAN destinations fail closed when the LAN path is unavailable.
FALLBACK=drop

# 5. AI/agent destination blacklist. These entries are WLAN-only and are
# dropped if they ever attempt to leave through LAN.
# Supports IPv4/IPv6 addresses and CIDRs, comma-separated.
BLACKLIST_IPS=203.0.113.10,2001:db8::10

# 6. Optional static answers. They avoid a live DNS query for these LAN domains.
LOCAL_DNS_RECORDS=server.lab=192.0.2.20;server.lab=2001:db8::20
